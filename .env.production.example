# Smart WMS — Production Environment Variables
# Copy this file to .env.production when setting up production build

# ─── Backend API URL (Render / Cloud Host) ───────────────────
VITE_API_URL=https://smart-wms-api.onrender.com/api/v1

# ─── App Meta ─────────────────────────────────────────────────
VITE_APP_NAME=Smart WMS
VITE_APP_VERSION=1.0.0

# ─── Auth Configuration ───────────────────────────────────────
VITE_TOKEN_EXPIRY=86400

# ─── Feature Flags ────────────────────────────────────────────
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_REPORTS=true

# Smart WMS — Environment Variables
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and should never be committed.

# ─── API Configuration ────────────────────────────────────────
# Base URL for the backend REST API (no trailing slash)
# Local development:
VITE_API_URL=http://localhost:8080/api/v1
# Production (Render backend):
# VITE_API_URL=https://smart-wms-api.onrender.com/api/v1

# ─── App Meta ─────────────────────────────────────────────────
VITE_APP_NAME=Smart WMS
VITE_APP_VERSION=1.0.0

# ─── Auth ─────────────────────────────────────────────────────
# JWT token expiry in seconds (for client-side display only)
VITE_TOKEN_EXPIRY=86400

# ─── Feature Flags ────────────────────────────────────────────
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_REPORTS=true
